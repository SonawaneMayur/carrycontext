{
  "name": "carrycontext",
  "displayName": "CarryContext: AI Session Handoffs",
  "description": "Never lose AI coding context. Automatic, verified, per-branch handoffs between Claude Code, Codex, Gemini CLI, Copilot and Cursor. Private by design.",
  "version": "0.6.1",
  "preview": true,
  "publisher": "sonawanemayur",
  "author": {
    "name": "Mayur Sonawane",
    "url": "https://github.com/SonawaneMayur"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0F172A",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SonawaneMayur/carrycontext.git"
  },
  "homepage": "https://github.com/SonawaneMayur/carrycontext#readme",
  "bugs": {
    "url": "https://github.com/SonawaneMayur/carrycontext/issues"
  },
  "qna": "https://github.com/SonawaneMayur/carrycontext/issues",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=22"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "ai",
    "claude",
    "claude code",
    "codex",
    "gemini",
    "copilot",
    "cursor",
    "handoff",
    "context",
    "compact",
    "llm",
    "agents",
    "apple intelligence",
    "on-device",
    "session",
    "memory",
    "git",
    "branch",
    "agents.md",
    "context window"
  ],
  "pricing": "Free",
  "main": "./src/extension.js",
  "bin": {
    "carrycontext": "./bin/carrycontext.js"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=90 --test-coverage-functions=85 --test-coverage-branches=75 \"test/**/*.test.js\"",
    "check": "node scripts/check.js",
    "package": "npx --yes @vscode/vsce@3 package"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "carrycontext.compactAll",
        "title": "Compact All: Create Handoff From All Sessions",
        "category": "CarryContext",
        "icon": "$(sync)"
      },
      {
        "command": "carrycontext.compactSession",
        "title": "Create Handoff From a Specific Session…",
        "category": "CarryContext"
      },
      {
        "command": "carrycontext.switchProvider",
        "title": "Switch To Provider…",
        "category": "CarryContext",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "carrycontext.openHandoff",
        "title": "Find Handoff…",
        "category": "CarryContext",
        "icon": "$(search)"
      },
      {
        "command": "carrycontext.copyResumePrompt",
        "title": "Copy Resume Prompt",
        "category": "CarryContext"
      },
      {
        "command": "carrycontext.installClaudeHooks",
        "title": "Install Claude Code Hooks (auto-handoff on compact / session end)",
        "category": "CarryContext"
      },
      {
        "command": "carrycontext.selectSummarizer",
        "title": "Select Summarizer LLM…",
        "category": "CarryContext",
        "icon": "$(sparkle)"
      },
      {
        "command": "carrycontext.setApiKey",
        "title": "Set API Key…",
        "category": "CarryContext"
      },
      {
        "command": "carrycontext.menu",
        "title": "Show Actions…",
        "category": "CarryContext"
      },
      {
        "command": "carrycontext.refreshView",
        "title": "Refresh",
        "category": "CarryContext",
        "icon": "$(refresh)"
      },
      {
        "command": "carrycontext.showCurrentBranchOnly",
        "title": "Show Current Branch Only",
        "category": "CarryContext",
        "icon": "$(filter)"
      },
      {
        "command": "carrycontext.showAllBranches",
        "title": "Show All Branches",
        "category": "CarryContext",
        "icon": "$(filter-filled)"
      },
      {
        "command": "carrycontext.usageReport",
        "title": "Show Usage Report",
        "category": "CarryContext",
        "icon": "$(graph)"
      },
      {
        "command": "carrycontext.exportUsage",
        "title": "Export Usage as CSV…",
        "category": "CarryContext"
      },
      {
        "command": "carrycontext.compactThisSession",
        "title": "Create Handoff From This Session",
        "category": "CarryContext",
        "icon": "$(sync)"
      },
      {
        "command": "carrycontext.restoreHandoff",
        "title": "Use as Latest Handoff",
        "category": "CarryContext",
        "icon": "$(history)"
      },
      {
        "command": "carrycontext.copyHandoff",
        "title": "Copy Handoff Text",
        "category": "CarryContext",
        "icon": "$(copy)"
      }
    ],
    "configuration": {
      "title": "CarryContext",
      "properties": {
        "carrycontext.summarizer.provider": {
          "type": "string",
          "scope": "machine",
          "default": "none",
          "enum": [
            "none",
            "anthropic",
            "openai",
            "gemini",
            "ollama",
            "apple",
            "openai-compatible"
          ],
          "enumDescriptions": [
            "No LLM: extract a handoff from the transcript directly (free, offline)",
            "Anthropic Claude API",
            "OpenAI API",
            "Google Gemini API",
            "Local Ollama server",
            "Apple's on-device model (Apple Intelligence): free, private, nothing leaves your Mac. Apple-silicon Mac, macOS 26, Command Line Tools. Small context, best for short sessions",
            "Any OpenAI-compatible endpoint (OpenRouter, Groq, Mistral, DeepSeek, LM Studio, ...)"
          ],
          "description": "Which LLM writes the handoff summary. User settings only: a workspace or repo cannot change it."
        },
        "carrycontext.summarizer.model": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Model id for the summarizer. Leave empty for the provider default. User settings only: a workspace or repo cannot change it."
        },
        "carrycontext.summarizer.baseUrl": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Override the API base URL (required for openai-compatible). Must be https, or http on localhost. User settings only: a workspace or repo cannot change it."
        },
        "carrycontext.sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "claude",
            "codex",
            "gemini"
          ],
          "description": "Providers whose session transcripts are read when compacting."
        },
        "carrycontext.targets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "claude",
            "codex",
            "gemini"
          ],
          "description": "Providers that get a copy of handoff.md (in .claude/, .codex/, .gemini/, .github/, .cursor/)."
        },
        "carrycontext.lookbackHours": {
          "type": "number",
          "default": 24,
          "description": "Compact All only includes sessions active within this many hours."
        },
        "carrycontext.autoUpdate.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Refresh the handoff automatically when a session goes idle (for providers without hooks)."
        },
        "carrycontext.autoUpdate.idleSeconds": {
          "type": "number",
          "default": 120,
          "description": "How long a session must be idle before it is auto-compacted."
        },
        "carrycontext.handoffLimit": {
          "type": "number",
          "default": 50,
          "description": "How many versions of each session's handoff to keep in .carrycontext/handoffs (oldest are deleted first). Every session always keeps its latest handoff."
        },
        "carrycontext.redact.enabled": {
          "type": "boolean",
          "scope": "machine",
          "default": true,
          "description": "Replace API keys, tokens, passwords and private keys with [REDACTED:…] in handoffs and in text sent to the summarizer LLM. User settings only: a workspace or repo cannot change it."
        },
        "carrycontext.redact.extraPatterns": {
          "type": "array",
          "scope": "machine",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra regular expressions to redact (for example your company's internal token format). User settings only: a workspace or repo cannot change it."
        },
        "carrycontext.verify.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Check what the session claims it did (file edits, test and build results, commits) against git and the session's recorded results, and add a Verification section to each handoff. Never runs project code."
        },
        "carrycontext.usage.showCost": {
          "type": "boolean",
          "default": true,
          "description": "Show estimated cost in usage stats, at Anthropic API list prices. On a Claude subscription you don't pay per token, so the figure is what the same work would cost through the API. Token counts are always shown."
        },
        "carrycontext.usage.prices": {
          "type": "object",
          "default": {},
          "markdownDescription": "Your own prices in $ per million tokens, by model id, for models without a built-in price or for a different rate. Example: `{\"claude-opus-5-5\": {\"input\": 4, \"output\": 20, \"cacheRead\": 0.2}}`. Cache writes default to 1.25× input (5-minute) and 2× (1-hour); set `cacheWrite5m` / `cacheWrite1h` to change them. Prices are never fetched from the internet."
        },
        "carrycontext.plainTerminalPrompt": {
          "type": "boolean",
          "default": false,
          "description": "Use a plain \"$ \" prompt in terminals CarryContext opens (hides user@host, e.g. for screen recordings)."
        },
        "carrycontext.maxTranscriptChars": {
          "type": "number",
          "scope": "machine",
          "default": 150000,
          "description": "Transcript characters sent to the summarizer LLM (head and tail are kept). User settings only: a workspace or repo cannot change it."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "carrycontext",
          "title": "CarryContext",
          "icon": "media/carrycontext.svg"
        }
      ]
    },
    "views": {
      "carrycontext": [
        {
          "id": "carrycontext.handoffs",
          "name": "Handoffs"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "carrycontext.handoffs",
        "contents": "Open a folder to start carrying context between AI sessions.\n[Open Folder](command:vscode.openFolder)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "carrycontext.openHandoff",
          "when": "view == carrycontext.handoffs",
          "group": "navigation@0"
        },
        {
          "command": "carrycontext.compactAll",
          "when": "view == carrycontext.handoffs",
          "group": "navigation@1"
        },
        {
          "command": "carrycontext.switchProvider",
          "when": "view == carrycontext.handoffs",
          "group": "navigation@2"
        },
        {
          "command": "carrycontext.showCurrentBranchOnly",
          "when": "view == carrycontext.handoffs && !carrycontext.currentBranchOnly",
          "group": "navigation@3"
        },
        {
          "command": "carrycontext.showAllBranches",
          "when": "view == carrycontext.handoffs && carrycontext.currentBranchOnly",
          "group": "navigation@3"
        },
        {
          "command": "carrycontext.refreshView",
          "when": "view == carrycontext.handoffs",
          "group": "navigation@4"
        },
        {
          "command": "carrycontext.selectSummarizer",
          "when": "view == carrycontext.handoffs",
          "group": "settings@1"
        },
        {
          "command": "carrycontext.setApiKey",
          "when": "view == carrycontext.handoffs",
          "group": "settings@2"
        },
        {
          "command": "carrycontext.installClaudeHooks",
          "when": "view == carrycontext.handoffs",
          "group": "settings@3"
        },
        {
          "command": "carrycontext.usageReport",
          "when": "view == carrycontext.handoffs",
          "group": "usage@1"
        },
        {
          "command": "carrycontext.exportUsage",
          "when": "view == carrycontext.handoffs",
          "group": "usage@2"
        }
      ],
      "view/item/context": [
        {
          "command": "carrycontext.compactThisSession",
          "when": "view == carrycontext.handoffs && viewItem == session",
          "group": "inline"
        },
        {
          "command": "carrycontext.restoreHandoff",
          "when": "view == carrycontext.handoffs && viewItem == handoffFile",
          "group": "inline@1"
        },
        {
          "command": "carrycontext.copyHandoff",
          "when": "view == carrycontext.handoffs && viewItem =~ /^(handoffFile|latest)$/",
          "group": "inline@2"
        },
        {
          "command": "carrycontext.switchProvider",
          "when": "view == carrycontext.handoffs && viewItem == latest",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "carrycontext.compactThisSession",
          "when": "false"
        },
        {
          "command": "carrycontext.restoreHandoff",
          "when": "false"
        },
        {
          "command": "carrycontext.refreshView",
          "when": "false"
        },
        {
          "command": "carrycontext.showCurrentBranchOnly",
          "when": "!carrycontext.currentBranchOnly"
        },
        {
          "command": "carrycontext.showAllBranches",
          "when": "carrycontext.currentBranchOnly"
        }
      ]
    }
  }
}
